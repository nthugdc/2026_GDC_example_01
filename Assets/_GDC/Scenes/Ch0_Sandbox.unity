  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d911147b30a566ae694388799a5c0696, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GuideBoard
  content: "\u7B2C 0 \u7AE0 \xB7 \u7269\u7406\u6C99\u76D2\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\u76EE\u6A19\uFF1A\u8B93\u9EC3\u7403\u6EFE\u9032\u53F3\u908A\u7684\u7C43\u5B50\u3002\n\u9019\u4E00\u7AE0\u4E0D\u7528\u5BEB\u7A0B\u5F0F\uFF0C\u53EA\u8981\u8ABF\u53C3\u6578\uFF01\n\n\u3010\u91CD\u8981\u3011\u8981\u5148\u300C\u505C\u6B62\u64AD\u653E\u300D\u518D\u6539\u53C3\u6578\n\u64AD\u653E\u4E2D\u6539\u7684\u6578\u503C\uFF0C\u4E00\u505C\u6B62\u5C31\u6703\u88AB\u9084\u539F\u3002\n\n1.
    \u6309\u5DE5\u5177\u5217\u4E2D\u9593\u7684\u300C\u505C\u6B62\u300D\u9375\n2.
    \u5728 Hierarchy \u9EDE\u9078\u300CBall\u300D\n3. \u5728 Inspector \u6539 Rigidbody
    2D \u7684\u53C3\u6578\n4. \u518D\u6309\u300C\u64AD\u653E\u300D\u9375\uFF0C\u770B\u7D50\u679C\n\n\u30FBLinear
    Damping\uFF08\u7A7A\u6C23\u963B\u529B\uFF09\n\u3000\u9810\u8A2D 2\uFF0C\u592A\u5927\u4E86\u885D\u4E0D\u904E\u7F3A\u53E3\n\u30FBGravity
    Scale\uFF08\u91CD\u529B\u500D\u7387\uFF09\n\u30FBMass\uFF08\u8CEA\u91CF\uFF09\u6539\u6539\u770B\u6709\u5DEE\u55CE\uFF1F\n\n\u6750\u8CEA\u7DF4\u7FD2\uFF1A\u628A
    _GDC/Physics \u88E1\u7684\nSlippery \u62D6\u5230 Ball \u7684 Circle\nCollider
    2D \u7684 Material \u6B04\u4F4D\u3002"
  textColor: {r: 0.9607843, g: 0.96862745, b: 0.98039216, a: 1}
  fontSize: 4
